# TEMPLATE ONLY: cp .env.example .env and generate unique high-entropy secrets outside git.
# Choose a free port before Cloudflare tunnel configuration.
ACADEMY_HOST_PORT=3080
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3080
# Production *after* explicit Cloudflare route approval:
# APP_ENV=production
# APP_BASE_URL=https://shopflow.rapidfox.io
# Optional: keep the loopback gateway usable by the teacher (Chrome) in production.
# APP_EXTRA_ORIGINS=http://127.0.0.1:3080
APP_PUBLIC_HOSTNAME=shopflow.rapidfox.io
# cloudflared lives OUTSIDE this Compose until its actual placement is confirmed.
CLOUDFLARE_TUNNEL_MODE=external
# Never put a tunnel token in a committed config, README, issue or PR.

POSTGRES_USER=academy
POSTGRES_PASSWORD=
POSTGRES_DB=academy
# MySQL only for --profile labs, can remain disabled during platform P0.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=shopflow
MYSQL_USER=shopflow_lab
MYSQL_PASSWORD=
# Session/cookie signing secret, not for browser exposure.
AUTH_SECRET=
# Optional tutor: absence of API key MUST NOT block boot or missions.
AI_PROVIDER=none
OPENROUTER_API_KEY=
AI_MODEL_EXPLANATION=
AI_MODEL_HINT=
