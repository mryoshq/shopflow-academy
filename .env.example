# TEMPLATE ONLY: cp .env.example .env and generate unique high-entropy secrets outside git.
# Choose a free port before Cloudflare tunnel configuration.
ACADEMY_HOST_PORT=3080
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3080
# Production *after* explicit Cloudflare route approval:
# APP_ENV=production
# APP_BASE_URL=https://shopflow.rapidfox.io
# Optional: keep the loopback gateway usable by the teacher (Chrome) in production.
# APP_EXTRA_ORIGINS=http://127.0.0.1:3080
APP_PUBLIC_HOSTNAME=shopflow.rapidfox.io
# cloudflared lives OUTSIDE this Compose until its actual placement is confirmed.
CLOUDFLARE_TUNNEL_MODE=external
# Never put a tunnel token in a committed config, README, issue or PR.

POSTGRES_USER=academy
POSTGRES_PASSWORD=
POSTGRES_DB=academy
# Automatic backups (backup service): absolute host path outside the repo and iCloud.
# BACKUP_DIR=/Users/<you>/Developer/shopflow-backups
BACKUP_KEEP=28
BACKUP_INTERVAL_HOURS=6
# Laboratory database (labdb, ADR-0017): three distinct secrets, generated by
# python3 scripts/init_lab_env.py (appends the missing ones, prints nothing).
LAB_POSTGRES_PASSWORD=
LAB_OWNER_PASSWORD=
LAB_READER_PASSWORD=
# MySQL (profile labs) is not used: the SQL lab is labdb.
MYSQL_ROOT_PASSWORD=
MYSQL_DATABASE=shopflow
MYSQL_USER=shopflow_lab
MYSQL_PASSWORD=
# Session/cookie signing secret, not for browser exposure.
AUTH_SECRET=
# Key of the opaque answer IDs. REQUIRED when APP_ENV=production (>= 32 characters):
# the backend refuses to start without it. Generate: python3 -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET=
# One class, one course (defaults shown).
# MAIN_COURSE_SLUG=python-data-engineering-sql
# CLASS_LABEL=Classe B3 IA/Data
# Optional tutor: absence of API key MUST NOT block boot or missions.
AI_PROVIDER=none
# Web Push (ADR-0023), optional: run `python3 scripts/vapid_keys.py` once on the Mac (writes both keys into .env).
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
OPENROUTER_API_KEY=
AI_MODEL_EXPLANATION=
AI_MODEL_HINT=
