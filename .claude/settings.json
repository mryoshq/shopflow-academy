{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "deny": [
      "Bash(git push --force *)",
      "Bash(git push -f *)",
      "Bash(git push --force-with-lease *)",
      "Bash(git push origin --delete *)",
      "Bash(git push origin :*)",
      "Bash(docker compose down -v *)",
      "Bash(docker compose down --volumes *)",
      "Bash(wrangler *)",
      "Bash(npx wrangler *)",
      "Bash(python3 scripts/upsert_teacher.py *)",
      "Bash(cat .env *)",
      "Bash(cat .local/*)",
      "Read(./.env)",
      "Read(./.env.*)",
      "Read(!.env.example)",
      "Read(./.local/**)",
      "Edit(./.local/**)",
      "Read(~/.cloudflared/**)",
      "Read(//Library/LaunchDaemons/com.cloudflare.cloudflared.plist)"
    ],
    "ask": [
      "Bash(cloudflared *)",
      "Bash(gh pr merge *)",
      "Bash(gh pr edit *)",
      "Bash(git push *)",
      "Bash(docker volume rm *)",
      "Bash(docker compose -p wordpress *)",
      "Bash(docker stop wordpress-n8n-1 *)",
      "Bash(docker rm wordpress-n8n-1 *)",
      "Bash(docker restart wordpress-n8n-1 *)",
      "Bash(python3 scripts/seed_demo.py *)",
      "Bash(sudo *)"
    ],
    "allow": [
      "Bash(git status *)",
      "Bash(git log *)",
      "Bash(git diff *)",
      "Bash(git show *)",
      "Bash(git branch *)",
      "Bash(gh pr view *)",
      "Bash(gh pr checks *)",
      "Bash(gh pr diff *)",
      "Bash(gh pr list *)",
      "Bash(gh run view *)",
      "Bash(gh run list *)",
      "Bash(../.venv/bin/python -m pytest *)",
      "Bash(python -m pytest *)",
      "Bash(npm run test *)",
      "Bash(npm run build)",
      "Bash(npm run test:e2e *)",
      "Bash(python3 scripts/verify_kit.py)",
      "Bash(python3 scripts/smoke_public.py *)",
      "Bash(docker compose ps *)",
      "Bash(docker compose logs *)"
    ]
  }
}
