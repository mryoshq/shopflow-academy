# Test stack only (scripts/test_stack.py): throwaway database, never the production one.
# Values are placeholders for a database reachable only on the stack's internal network.
# Compose reads ONLY this file for the test stack (--env-file), never the production .env.
ACADEMY_HOST_PORT=3180
APP_ENV=development
APP_BASE_URL=http://127.0.0.1:3180
APP_EXTRA_ORIGINS=
APP_SECRET=
AI_PROVIDER=none
POSTGRES_USER=academy_test
POSTGRES_PASSWORD=test_stack_placeholder_not_for_deployment
POSTGRES_DB=academy_test
BACKUP_DIR=./.backups-test
BACKUP_KEEP=4
BACKUP_INTERVAL_HOURS=6
